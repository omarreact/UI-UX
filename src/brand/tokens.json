{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "brand": "Softly Solutions",
  "type": "Independent fictional design showcase identity",
  "version": "1.1.0",
  "positioning": "Thoughtful digital design and practical technology, expressed with warmth.",
  "tagline": "Ideas with intention.",
  "supportingLine": "Smarter digital. Stronger brands.",
  "voice": {
    "personality": [
      "thoughtful",
      "clear",
      "warm",
      "imaginative",
      "credible"
    ],
    "principles": [
      "Lead with what matters to the audience.",
      "Explain benefits without invented numbers.",
      "Use confident and approachable language.",
      "Avoid jargon for its own sake.",
      "Label concept work honestly."
    ]
  },
  "colors": {
    "night": {
      "hex": "#120807",
      "role": "Hero and dark backgrounds"
    },
    "ink": {
      "hex": "#211915",
      "role": "Primary text"
    },
    "canvas": {
      "hex": "#F4F1EC",
      "role": "Section background"
    },
    "paper": {
      "hex": "#FFFAF4",
      "role": "Editorial surfaces"
    },
    "signal": {
      "hex": "#FF6B35",
      "role": "Primary action and brand accent"
    },
    "muted": {
      "hex": "#8D8178",
      "role": "Secondary copy"
    },
    "apricot": {
      "hex": "#FF954A",
      "role": "Gradient highlight"
    }
  },
  "typography": {
    "display": "Georgia, Times New Roman, serif",
    "body": "Inter, system-ui, -apple-system, Segoe UI, Arial, sans-serif",
    "interface": "system-ui, sans-serif",
    "wordmark": "Georgia, Times New Roman, serif; heavy weight, tight tracking, contrasting orange final period"
  },
  "shape": {
    "logoCornerRadiusPercent": null,
    "button": "pill",
    "surfaces": "soft radius 12–32px",
    "motif": "Typography-only Softly. wordmark with a contrasting orange period; compact S. lettermark for small-square surfaces"
  },
  "assets": {
    "mark": "mark.svg (typographic S. monogram)",
    "logoOnDark": "logo-on-dark.svg (text-only)",
    "logoOnLight": "logo-on-light.svg (text-only)",
    "socialCard": "social-card.png",
    "appIcon": "icon-512.png"
  }
}
